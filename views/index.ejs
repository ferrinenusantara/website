<%- include('partials/header') %>

<!-- Hero Section -->
<section id="hero" class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <h1>Building Reliable & <span>Innovative</span> Digital Solutions</h1>
        <p><%= company.tagline %></p>
        <div class="hero-buttons">
          <a href="#products" class="btn btn-primary" id="btn-hero-products">View Products</a>
          <a href="#visi-misi" class="btn btn-secondary" id="btn-hero-about">About Us</a>
        </div>
      </div>
      <div class="hero-image-wrapper">
        <img src="/images/hero_banner.png" alt="Ferrine Workspace Illustration" id="hero-img">
      </div>
    </div>
  </div>
</section>

<!-- Visi & Misi Section -->
<section id="visi-misi" class="section-alt">
  <div class="container">
    <div class="section-header">
      <h2>Our Vision & Mission</h2>
      <p>Our direction and commitment to advancing the technology landscape in Indonesia.</p>
    </div>
    
    <div class="about-grid">
      <div class="about-text">
        <h3>Company Vision</h3>
        <p><%= company.vision %></p>
      </div>
      <div class="about-mission">
        <h3>Our Mission</h3>
        <ul class="mission-list">
          <% company.mission.forEach(function(item) { %>
            <li><%= item %></li>
          <% }); %>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Core Values Section -->
<section id="values">
  <div class="container">
    <div class="section-header">
      <h2>Core Values</h2>
      <p>The fundamental values that define our identity, spelling out <strong>F.E.R.R.I.N.E.</strong></p>
    </div>

    <div class="ferrine-values-container">
      <% company.coreValues.forEach(function(value, index) { %>
        <div class="ferrine-value-row" id="value-row-<%= index %>">
          <div class="ferrine-letter">
            <%= value.title.charAt(0) %>
          </div>
          <div class="ferrine-value-content">
            <h3><%= value.title %></h3>
            <p><%= value.desc %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Products Section -->
<section id="products" class="section-alt">
  <div class="container">
    <div class="section-header">
      <h2>Free & Open Source Software</h2>
      <p>Explore our ecosystem of free, open-source frameworks, applications, and developer tools built to empower the community.</p>
    </div>

    <div class="products-grid">
      <% company.products.forEach(function(product) { %>
        <div class="product-card" id="product-card-<%= product.id %>">
          <div class="product-content">
            <span class="product-tag"><%= product.badge %></span>
            <h3><%= product.name %></h3>
            <p class="product-description"><%= product.description %></p>
          </div>
          
          <% if (product.linkText) { %>
            <% if (product.url && product.url.startsWith('#')) { %>
              <a href="<%= product.url %>" class="product-link" id="link-<%= product.id %>">
                <%- product.linkText %>
              </a>
            <% } else if (product.url) { %>
              <a href="<%= product.url %>" target="_blank" rel="noopener noreferrer" class="product-link" id="link-<%= product.id %>">
                <%- product.linkText %>
              </a>
            <% } else { %>
              <span class="product-link" style="opacity: 0.5; cursor: default;">
                <%- product.linkText %>
              </span>
            <% } %>
          <% } %>
        </div>
      <% }); %>
    </div>

    <div class="products-more">
      <p>Interested in contributing, reporting bugs, or need help with custom integrations?</p>
      <a href="#contact" class="btn btn-secondary" id="btn-products-more">Get in Touch &rarr;</a>
    </div>
  </div>
</section>

<!-- Contact Section -->
<section id="contact">
  <div class="container">
    <div class="section-header">
      <h2>Contact Us</h2>
      <p>Have questions or interested in collaborating? Send a message to our team.</p>
    </div>

    <div class="contact-grid">
      <div class="contact-info">
        <h3>Let's Talk</h3>
        <p>Get in touch with us through Ferrine's official communication channels to get support or solutions tailored to your digital business needs.</p>
        
        <div class="info-list">
          <div class="info-item">
            <div class="info-icon">📍</div>
            <div class="info-text">
              <h4>Location</h4>
              <p>Indonesia</p>
            </div>
          </div>
          <div class="info-item">
            <div class="info-icon">✉️</div>
            <div class="info-text">
              <h4>Email</h4>
              <p>info@ferrine.com</p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <form action="#" method="POST" id="contact-form" onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent successfully.');">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Your Name" required>
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="email@domain.com" required>
          </div>
          <div class="form-group">
            <label for="message">Your Message</label>
            <textarea id="message" name="message" class="form-control" placeholder="Write your message or inquiry here..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" id="btn-submit-contact" style="width: 100%; border: none;">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
